<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Applied to MainActivity from the manifest, so it covers the launch window only.
         installSplashScreen() swaps the window over to postSplashScreenTheme once the first
         frame is ready. The attribute names are the library's own, unprefixed. It maps them
         onto the platform android:windowSplashScreen* attributes on API 31+ and emulates them
         below, which the hand-written values-v31 theme this replaces never did. -->
    <style name="Theme.Ganzhornfest.Splash" parent="Theme.SplashScreen">
        <!-- window_background, not ic_launcher_background. The two are the same wine in light
             mode, but only window_background has a values-night variant, so this drops a
             wine-then-dark-brown flash at handoff in dark mode. -->
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ganzhornfest</item>
    </style>

    <!-- No AppCompat parent. MainActivity is a ComponentActivity and Compose owns every colour,
         so this carries window attributes and nothing else. -->
    <style name="Theme.Ganzhornfest" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Ignored from API 35, honoured on 24 to 34, where they stop a coloured frame between
             the splash handoff and enableEdgeToEdge() in onCreate. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
