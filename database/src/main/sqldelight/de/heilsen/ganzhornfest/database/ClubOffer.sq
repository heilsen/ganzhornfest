CREATE TABLE clubOffer (id INTEGER PRIMARY KEY AUTOINCREMENT, poiId INTEGER NOT NULL, offerId INTEGER NOT NULL);

selectOffersByPoiId:
SELECT offer.id, offer.name, offer.description
FROM clubOffer
INNER JOIN offer ON offer.id = clubOffer.offerId
WHERE clubOffer.poiId = :poiId
ORDER BY offer.name COLLATE NOCASE;

selectClubsByOfferId:
SELECT DISTINCT poi.id, poi.name
FROM clubOffer
INNER JOIN poi ON poi.id = clubOffer.poiId
WHERE clubOffer.offerId = :offerId
ORDER BY poi.name COLLATE NOCASE;

insert:
INSERT INTO clubOffer(id, poiId, offerId) VALUES (?, ?, ?);

deleteAll:
DELETE FROM clubOffer;
