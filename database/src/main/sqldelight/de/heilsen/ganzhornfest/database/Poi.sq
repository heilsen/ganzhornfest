CREATE TABLE IF NOT EXISTS poi (id INTEGER PRIMARY KEY NOT NULL, name TEXT NOT NULL, typeId INTEGER NOT NULL);

selectAll:
SELECT * FROM poi;

selectClubs:
SELECT * FROM poi WHERE typeId = 1;

selectNameById:
SELECT name FROM poi WHERE id = :id;

selectStages:
SELECT * FROM poi WHERE typeId = 2;

countClubs:
SELECT count(*) FROM poi WHERE typeId = 1;

insert:
INSERT INTO poi(id, name, typeId) VALUES (?, ?, ?);

deleteAll:
DELETE FROM poi;
