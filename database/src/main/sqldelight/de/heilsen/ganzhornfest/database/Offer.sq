CREATE TABLE IF NOT EXISTS offer (id INTEGER PRIMARY KEY NOT NULL, typeId INTEGER NOT NULL, name TEXT NOT NULL, description TEXT);

selectAllDrinks:
SELECT offer.id, offer.name, offer.description, group_concat(DISTINCT poi.name) AS clubs
FROM offer
JOIN clubOffer ON clubOffer.offerId = offer.id
JOIN poi ON poi.id = clubOffer.poiId
WHERE offer.typeId = 1
GROUP BY offer.id;

selectAllFood:
SELECT offer.id, offer.name, offer.description, group_concat(DISTINCT poi.name) AS clubs
FROM offer
JOIN clubOffer ON clubOffer.offerId = offer.id
JOIN poi ON poi.id = clubOffer.poiId
WHERE offer.typeId = 2
GROUP BY offer.id;

selectAllOthers:
SELECT * FROM offer WHERE typeId = 3;

selectNameById:
SELECT name FROM offer WHERE id = :id;

selectOthersByName:
SELECT * FROM offer
WHERE typeId = 3
AND (name LIKE '%' || :name || '%' OR description LIKE '%' || :name || '%');

selectByName:
SELECT * FROM offer
WHERE name LIKE '%' || :name || '%' OR description LIKE '%' || :name || '%';

selectAll:
SELECT * FROM offer;

insert:
INSERT INTO offer(id, typeId, name, description) VALUES (?, ?, ?, ?);

deleteAll:
DELETE FROM offer;
