CREATE TABLE poiCoordinate (id INTEGER PRIMARY KEY AUTOINCREMENT, poiId INTEGER NOT NULL, coordinateId INTEGER NOT NULL);

selectAll:
SELECT poi.id AS poiId, poi.name AS poiName, pt.name AS type, c.lat, c.lng
FROM poiCoordinate AS pc
INNER JOIN poi ON pc.poiId = poi.id
INNER JOIN poiType AS pt ON poi.typeId = pt.id
INNER JOIN coordinate AS c ON pc.coordinateId = c.id;

selectByClubName:
SELECT poi.id AS poiId, poi.name AS poiName, c.lat, c.lng
FROM poiCoordinate AS pc
INNER JOIN poi ON pc.poiId = poi.id
INNER JOIN coordinate AS c ON pc.coordinateId = c.id
WHERE poi.typeId = 1 AND poi.name LIKE '%' || :name || '%';

selectByOfferName:
SELECT poi.id AS poiId, poi.name AS poiName, c.lat, c.lng
FROM poi
INNER JOIN clubOffer ON clubOffer.poiId = poi.id
INNER JOIN offer ON offer.id = clubOffer.offerId
INNER JOIN poiCoordinate AS pc ON pc.poiId = poi.id
INNER JOIN coordinate AS c ON pc.coordinateId = c.id
WHERE poi.typeId = 1
AND offer.name LIKE '%' || :name || '%';

selectClubPins:
SELECT
    poi.id AS poiId,
    poi.name AS name,
    coordinate.id AS coordinateId,
    coordinate.lat AS lat,
    coordinate.lng AS lng
FROM poi
INNER JOIN poiCoordinate ON poiCoordinate.poiId = poi.id
INNER JOIN coordinate ON coordinate.id = poiCoordinate.coordinateId
ORDER BY poi.name;

insert:
INSERT INTO poiCoordinate(id, poiId, coordinateId) VALUES (?, ?, ?);

deleteAll:
DELETE FROM poiCoordinate;
