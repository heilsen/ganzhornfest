CREATE TABLE IF NOT EXISTS offerAlias (id INTEGER PRIMARY KEY AUTOINCREMENT, offerId INTEGER NOT NULL, alias TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS idx_offerAlias_alias ON offerAlias(alias);

selectAll:
SELECT * FROM offerAlias;

insert:
INSERT INTO offerAlias(id, offerId, alias) VALUES (?, ?, ?);

deleteAll:
DELETE FROM offerAlias;
